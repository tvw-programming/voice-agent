# Copy to .env and fill in. Never commit .env.

# --- Staff PINs (Feature 6) ---
# Secret used to hash staff PINs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
STAFF_PIN_SECRET=
# Legacy shared PIN, used only while no staff are enrolled in data/staff.json
STAFF_PIN=4321

# --- Student lookup (required for lookups) ---
# Express API in student_api/ (npm start). For the older Python mock use http://127.0.0.1:8001 and mock-key.
STUDENT_API_BASE_URL=http://127.0.0.1:3000/api/v1
STUDENT_API_KEY=dev-key

# --- Cloud fallbacks (optional; leave empty to run fully local) ---
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# --- Optional overrides ---
# VOICE_GENDER=female
